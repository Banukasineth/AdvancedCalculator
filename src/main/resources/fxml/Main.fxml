                        <Button text="rad" styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="10" GridPane.rowIndex="4"/>
                    </GridPane>

                    <!-- Basic Keypad -->
                    <GridPane fx:id="basicKeypad" hgap="8" vgap="8" visible="false" managed="false" styleClass="advanced-keypad">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" minWidth="40" percentWidth="25"/>
                            <ColumnConstraints hgrow="ALWAYS" minWidth="40" percentWidth="25"/>
                            <ColumnConstraints hgrow="ALWAYS" minWidth="40" percentWidth="25"/>
                            <ColumnConstraints hgrow="ALWAYS" minWidth="40" percentWidth="25"/>
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints vgrow="ALWAYS" minHeight="40"/>
                            <RowConstraints vgrow="ALWAYS" minHeight="40"/>
                            <RowConstraints vgrow="ALWAYS" minHeight="40"/>
                            <RowConstraints vgrow="ALWAYS" minHeight="40"/>
                            <RowConstraints vgrow="ALWAYS" minHeight="40"/>
                            <RowConstraints vgrow="ALWAYS" minHeight="40"/>
