<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.web.WebView?>

<StackPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.banukasineth.advancedcalculator.app.controller.CalculatorController"
           styleClass="root-pane">

    <BorderPane fx:id="rootPane" focusTraversable="true" onKeyPressed="#handleKeyPressed" styleClass="main-border-pane">

        <!-- Custom Top Bar for Undecorated Window -->
        <top>
            <HBox fx:id="titleBar" alignment="CENTER_LEFT" styleClass="custom-title-bar" onMousePressed="#handleTitleBarPressed" onMouseDragged="#handleTitleBarDragged">
                
                <!-- App Tabs -->
                <HBox alignment="CENTER_LEFT" spacing="5" styleClass="title-tabs">
                    <HBox alignment="CENTER" styleClass="active-tab">
                        <Label text="🖩 Calculator" styleClass="tab-text"/>
                        <Button text="×" styleClass="tab-close-btn"/>
                    </HBox>
                    <Button text="+" styleClass="new-tab-btn"/>
                </HBox>

                <Region HBox.hgrow="ALWAYS" />

                <!-- Window Controls -->
                <HBox alignment="CENTER_RIGHT" styleClass="window-controls">
                    <Button text="—" styleClass="window-btn, minimize-btn" onAction="#minimizeWindow"/>
                    <Button text="□" styleClass="window-btn, maximize-btn" onAction="#maximizeWindow"/>
                    <Button text="✕" styleClass="window-btn, close-btn" onAction="#closeWindow"/>
                </HBox>
            </HBox>
        </top>

        <center>
            <VBox spacing="10" styleClass="calculator-content">
                <padding>
                    <Insets top="15" right="20" bottom="20" left="20"/>
                </padding>

                <!-- Toolbar (Undo, Redo, Zoom, etc.) -->
                <HBox alignment="CENTER_LEFT" spacing="15" styleClass="toolbar">
                    <Button text="◫" styleClass="toolbar-btn"/>
                    <Button text="↩" styleClass="toolbar-btn"/>
                    <Button text="↪" styleClass="toolbar-btn"/>
                    <Button text="🗑" styleClass="toolbar-btn"/>
                    
                    <Region HBox.hgrow="ALWAYS"/>
                    
                    <!-- Zoom Slider placeholder -->
                    <HBox alignment="CENTER" spacing="5" styleClass="zoom-container">
                        <Label text="−" styleClass="zoom-icon"/>
                        <Slider value="100" min="50" max="200" styleClass="zoom-slider"/>
                        <Label text="+ 100%" styleClass="zoom-text"/>
                    </HBox>
                    
                    <Region HBox.hgrow="ALWAYS"/>
                    
                    <Button text="🗑" styleClass="toolbar-btn"/>
                    <Button text="✎" styleClass="toolbar-btn"/>
                    <Button text="⚙" styleClass="toolbar-btn"/>
                </HBox>

                <!-- Display Area -->
                <HBox spacing="10" VBox.vgrow="ALWAYS" styleClass="display-split-area">
                    
                    <!-- Working Area (Left) -->
                    <VBox fx:id="workingArea" HBox.hgrow="ALWAYS" styleClass="working-area">
                        <Label text="Working" styleClass="area-title"/>
                        <VBox alignment="CENTER" VBox.vgrow="ALWAYS">
                            <!-- Complex math rendering WebView -->
                            <WebView fx:id="mathWebView" prefHeight="200" prefWidth="400" VBox.vgrow="ALWAYS" style="-fx-page-fill: transparent;" />
                            <!-- Old display mapped here temporarily so controller doesn't break -->
                            <TextField fx:id="display" editable="false" text="0" visible="false" managed="false"/>
                            <Label fx:id="expressionLabel" visible="false" managed="false"/>
                        </VBox>
                    </VBox>
                    
                    <!-- Divider -->
                    <Region fx:id="verticalDivider" visible="false" managed="false" styleClass="vertical-divider"/>

                    <!-- Solution Area (Right) -->
                    <VBox fx:id="solutionArea" HBox.hgrow="ALWAYS" prefWidth="0" minWidth="0" maxWidth="0" styleClass="solution-area">
                        <Label text="Solution" styleClass="area-title"/>
                        <StackPane VBox.vgrow="ALWAYS">
                            <!-- Loading Orb State -->
                            <VBox fx:id="loadingBox" alignment="CENTER" visible="true">
                                <Region VBox.vgrow="ALWAYS"/>
                                <Circle radius="30" styleClass="solution-orb"/>
                                <Label text="Generating a&#10;solution..." textAlignment="CENTER" styleClass="solution-text"/>
                                <Region VBox.vgrow="ALWAYS"/>
                            </VBox>
                            
                            <!-- AI Solution WebView -->
                            <WebView fx:id="solutionWebView" visible="false" style="-fx-page-fill: transparent;" />
                        </StackPane>
                    </VBox>
                    
                </HBox>

                <!-- Input Field -->
                <HBox alignment="CENTER_LEFT" styleClass="input-area">
                    <TextField promptText="Type Math equation here" HBox.hgrow="ALWAYS" styleClass="math-input-field"/>
                    <Button text="🎤" styleClass="input-icon-btn"/>
                    <Button text="📷" styleClass="input-icon-btn"/>
                </HBox>

                <!-- Mode Selectors -->
                <HBox spacing="10" styleClass="mode-selectors">
                    <ComboBox promptText="Advanced" styleClass="mode-combo" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <ComboBox promptText="Equation Library" styleClass="mode-combo" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <ComboBox promptText="Differentiation" styleClass="mode-combo" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                </HBox>

                <!-- Advanced Keypad -->
                <GridPane VBox.vgrow="ALWAYS" hgap="8" vgap="8" styleClass="advanced-keypad">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="40" percentWidth="9"/>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="40" percentWidth="9"/>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="40" percentWidth="9"/>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="40" percentWidth="9"/>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="40" percentWidth="9"/>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="40" percentWidth="10"/>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="40" percentWidth="9"/>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="40" percentWidth="9"/>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="40" percentWidth="9"/>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="40" percentWidth="9"/>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="40" percentWidth="9"/>
                    </columnConstraints>
                    
                    <rowConstraints>
                        <RowConstraints vgrow="ALWAYS" minHeight="40"/>
                        <RowConstraints vgrow="ALWAYS" minHeight="40"/>
                        <RowConstraints vgrow="ALWAYS" minHeight="40"/>
                        <RowConstraints vgrow="ALWAYS" minHeight="40"/>
                        <RowConstraints vgrow="ALWAYS" minHeight="40"/>
                    </rowConstraints>

                    <!-- Row 0 -->
                    <Button text="⌫" styleClass="key-btn, action-btn" onAction="#backspace" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <Button text="(" styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <Button text=")" styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                    <Button text="mod" styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                    <Button text="π" styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="4" GridPane.rowIndex="0"/>
                    <Button text="↑n" styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="5" GridPane.rowIndex="0"/>
                    <Button text="n↓" styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="6" GridPane.rowIndex="0"/>
                    <Button text="cos" styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="7" GridPane.rowIndex="0"/>
                    <Button text="sin" styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="8" GridPane.rowIndex="0"/>
                    <Button text="tan" styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="9" GridPane.rowIndex="0"/>
                    <Button text="csc" styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="10" GridPane.rowIndex="0"/>

                    <!-- Row 1 -->
                    <Button fx:id="btn7" text="7" styleClass="key-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <Button fx:id="btn8" text="8" styleClass="key-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    <Button fx:id="btn9" text="9" styleClass="key-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                    <Button fx:id="btnDivide" text="÷" styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                    <Button text="√" styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="4" GridPane.rowIndex="1"/>
                    <Button text="A=B" styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="5" GridPane.rowIndex="1"/>
                    <Button text="x10ⁿ" styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="6" GridPane.rowIndex="1"/>
                    <Button text="cosh" styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="7" GridPane.rowIndex="1"/>
                    <Button text="sinh" styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="8" GridPane.rowIndex="1"/>
                    <Button text="tanh" styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="9" GridPane.rowIndex="1"/>
                    <Button text="sec" styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="10" GridPane.rowIndex="1"/>

                    <!-- Row 2 -->
                    <Button fx:id="btn4" text="4" styleClass="key-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <Button fx:id="btn5" text="5" styleClass="key-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                    <Button fx:id="btn6" text="6" styleClass="key-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                    <Button fx:id="btnMultiply" text="×" styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="3" GridPane.rowIndex="2"/>
                    <Button text="x²" styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="4" GridPane.rowIndex="2"/>
                    <Button text="xʸ" styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="5" GridPane.rowIndex="2"/>
                    <Button text="x⁻¹" styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="6" GridPane.rowIndex="2"/>
                    <Button text="e" styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="7" GridPane.rowIndex="2"/>
                    <Button text="ln" styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="8" GridPane.rowIndex="2"/>
                    <Button text="log" styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="9" GridPane.rowIndex="2"/>
                    <Button text="cot" styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="10" GridPane.rowIndex="2"/>

                    <!-- Row 3 -->
                    <Button fx:id="btn1" text="1" styleClass="key-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                    <Button fx:id="btn2" text="2" styleClass="key-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                    <Button fx:id="btn3" text="3" styleClass="key-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
                    <Button fx:id="btnSubtract" text="-" styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="3" GridPane.rowIndex="3"/>
                    <Button fx:id="btnEquals" text="=" styleClass="key-btn, action-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="4" GridPane.rowIndex="3" GridPane.rowSpan="2"/>
                    <Button text="x!" styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="5" GridPane.rowIndex="3"/>
                    <Button text="|x|" styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="6" GridPane.rowIndex="3"/>
                    <Button text="i" styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="7" GridPane.rowIndex="3"/>
                    <Button text="Re" styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="8" GridPane.rowIndex="3"/>
                    <Button text="Im" styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="9" GridPane.rowIndex="3"/>
                    <Button text="deg" styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="10" GridPane.rowIndex="3"/>

                    <!-- Row 4 -->
                    <Button fx:id="btn0" text="0" styleClass="key-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                    <Button fx:id="btnDecimal" text="." styleClass="key-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                    <Button text="\%" styleClass="key-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="2" GridPane.rowIndex="4"/>
                    <Button fx:id="btnAdd" text="+" styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="3" GridPane.rowIndex="4"/>
                    <!-- Column 4 is spanned by Equals -->
                    <Button text="x" styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="5" GridPane.rowIndex="4" GridPane.columnSpan="2"/>
                    <Button text="f(x)" styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="7" GridPane.rowIndex="4"/>
                    <Button text="conj" styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="8" GridPane.rowIndex="4"/>
                    <Button text="arg" styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="9" GridPane.rowIndex="4"/>
                    <Button text="rad" styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="10" GridPane.rowIndex="4"/>

                </GridPane>

            </VBox>
        </center>

    </BorderPane>

</StackPane>