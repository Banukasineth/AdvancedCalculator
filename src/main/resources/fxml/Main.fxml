<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.web.WebView?>

<StackPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.banukasineth.advancedcalculator.app.controller.CalculatorController"
    styleClass="root-pane" stylesheets="@../css/style.css">

    <BorderPane fx:id="rootPane" focusTraversable="true" onKeyPressed="#handleKeyPressed"
        styleClass="main-border-pane">

        <!-- Custom Top Bar for Undecorated Window -->
        <top>
            <HBox fx:id="titleBar" alignment="CENTER_LEFT" styleClass="custom-title-bar"
                onMousePressed="#handleTitleBarPressed" onMouseDragged="#handleTitleBarDragged">

                <!-- Far-left sidebar toggle -->
                <Button styleClass="toolbar-btn" focusTraversable="false">
                    <graphic>
                        <SVGPath content="M19 4H5c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm-12 14H5V6h2v12zm12 0H9V6h10v12z"
                                 styleClass="svg-icon" scaleX="0.7" scaleY="0.7" />
                    </graphic>
                </Button>

                <!-- App Tabs -->
                <HBox alignment="CENTER_LEFT" spacing="6" styleClass="title-tabs">
                    <HBox alignment="CENTER" spacing="7" styleClass="active-tab">
                        <SVGPath content="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM7 10h2v2H7v-2zm4 0h2v2h-2v-2zm4 0h2v2h-2v-2zm-8 4h2v2H7v-2zm4 0h2v2h-2v-2zm4 0h2v2h-2v-2z"
                                 fill="#8C889B" scaleX="0.65" scaleY="0.65" />
                        <Label text="Calculator" styleClass="tab-text" />
                        <Button styleClass="tab-close-btn" focusTraversable="false">
                            <graphic>
                                <SVGPath content="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                         styleClass="svg-icon" scaleX="0.45" scaleY="0.45" />
                            </graphic>
                        </Button>
                    </HBox>
                    <Button styleClass="new-tab-btn" focusTraversable="false">
                        <graphic>
                            <SVGPath content="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"
                                     styleClass="svg-icon" scaleX="0.55" scaleY="0.55" />
                        </graphic>
                    </Button>
                </HBox>

                <Region HBox.hgrow="ALWAYS" />

                <!-- Window Controls -->
                <HBox alignment="CENTER_RIGHT" styleClass="window-controls">
                    <Button styleClass="window-btn, minimize-btn" onAction="#minimizeWindow" focusTraversable="false">
                        <graphic>
                            <SVGPath content="M6 12h12v2H6z" styleClass="svg-icon" scaleX="0.75" scaleY="0.75" />
                        </graphic>
                    </Button>
                    <Button styleClass="window-btn, maximize-btn" onAction="#maximizeWindow" focusTraversable="false">
                        <graphic>
                            <SVGPath content="M3 3h6v2H5v4H3V3zm18 0v6h-2V5h-4V3h6zm0 18h-6v-2h4v-4h2v6zM3 21v-6h2v4h4v2H3z"
                                     styleClass="svg-icon" scaleX="0.7" scaleY="0.7" />
                        </graphic>
                    </Button>
                    <Button styleClass="window-btn, close-btn" onAction="#closeWindow" focusTraversable="false">
                        <graphic>
                            <SVGPath content="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                     styleClass="svg-icon" scaleX="0.6" scaleY="0.6" />
                        </graphic>
                    </Button>
                </HBox>
            </HBox>
        </top>

        <center>
            <StackPane>
                <VBox fx:id="standardLayout" spacing="10" styleClass="calculator-content">
                    <padding>
                        <Insets top="15" right="20" bottom="20" left="20" />
                    </padding>

                    <!-- Toolbar (Separate Floating Button Tiles + Wide Zoom Pill) -->
                    <HBox fx:id="toolbarHBox" alignment="CENTER_LEFT" styleClass="toolbar">
                        <!-- Left Group: 4 Separate Tile Buttons -->
                        <HBox alignment="CENTER_LEFT" spacing="6">
                            <!-- Sidebar Panel Toggle -->
                            <Button styleClass="toolbar-tile-btn, tb-panel-btn" focusTraversable="false">
                                <tooltip>
                                    <Tooltip text="Toggle Sidebar Panel" />
                                </tooltip>
                                <graphic>
                                    <SVGPath content="M3 5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5z M9 3v18 M4 5h5v14H4z"
                                             styleClass="svg-icon" scaleX="0.95" scaleY="0.95" />
                                </graphic>
                            </Button>
                            <!-- Undo -->
                            <Button styleClass="toolbar-tile-btn, tb-undo-btn" onAction="#handleUndo" focusTraversable="false">
                                <tooltip>
                                    <Tooltip text="Undo (Ctrl+Z)" />
                                </tooltip>
                                <graphic>
                                    <SVGPath content="M3 7v6h6 M21 17a9 9 0 0 0-9-9 9 9 0 0 0-6 2.3L3 13"
                                             styleClass="svg-icon" scaleX="0.95" scaleY="0.95" />
                                </graphic>
                            </Button>
                            <!-- Redo -->
                            <Button styleClass="toolbar-tile-btn, tb-redo-btn" onAction="#handleRedo" focusTraversable="false">
                                <tooltip>
                                    <Tooltip text="Redo (Ctrl+Y)" />
                                </tooltip>
                                <graphic>
                                    <SVGPath content="M21 7v6h-6 M3 17a9 9 0 0 1 9-9 9 9 0 0 1 6 2.3l3 2.7"
                                             styleClass="svg-icon" scaleX="0.95" scaleY="0.95" />
                                </graphic>
                            </Button>
                            <!-- Clipboard with Caret -->
                            <Button styleClass="toolbar-tile-btn, tb-clipboard-btn" focusTraversable="false" onAction="#handlePasteClipboard">
                                <tooltip>
                                    <Tooltip text="Paste from Clipboard" />
                                </tooltip>
                                <graphic>
                                    <HBox alignment="CENTER" spacing="3">
                                        <SVGPath content="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2 M9 2h6a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1H9a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1z"
                                                 styleClass="svg-icon" scaleX="0.75" scaleY="0.75" />
                                        <SVGPath content="M6 9l6 6 6-6"
                                                 styleClass="svg-icon" scaleX="0.5" scaleY="0.5" />
                                    </HBox>
                                </graphic>
                            </Button>
                        </HBox>

                        <Region HBox.hgrow="ALWAYS" minWidth="15" maxWidth="30" />

                        <!-- Center: Wide Zoom Slider Bar -->
                        <HBox alignment="CENTER" spacing="12" styleClass="zoom-pill" HBox.hgrow="ALWAYS">
                            <Label text="−" styleClass="zoom-icon" />
                            <Slider fx:id="zoomSlider" value="100" min="0" max="200" styleClass="zoom-slider" HBox.hgrow="ALWAYS" />
                            <Label fx:id="zoomLabel" text="+ 100%" styleClass="zoom-text" minWidth="-Infinity" />
                        </HBox>

                        <Region HBox.hgrow="ALWAYS" minWidth="15" maxWidth="30" />

                        <!-- Right Group: 3 Separate Tile Buttons -->
                        <HBox alignment="CENTER_RIGHT" spacing="6">
                            <!-- Trash can -->
                            <Button styleClass="toolbar-tile-btn, tb-trash-btn" onAction="#clearDisplay" focusTraversable="false">
                                <tooltip>
                                    <Tooltip text="Clear Working Area" />
                                </tooltip>
                                <graphic>
                                    <SVGPath content="M3 6h18 M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6 M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2 M10 11v6 M14 11v6"
                                             styleClass="svg-icon" scaleX="0.95" scaleY="0.95" />
                                </graphic>
                            </Button>
                            <!-- Pencil / Edit -->
                            <Button styleClass="toolbar-tile-btn, tb-edit-btn" focusTraversable="false">
                                <tooltip>
                                    <Tooltip text="Draw / Edit Equation" />
                                </tooltip>
                                <graphic>
                                    <SVGPath content="M17 3a2.85 2.85 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z M15 5l4 4"
                                             styleClass="svg-icon" scaleX="0.95" scaleY="0.95" />
                                </graphic>
                            </Button>
                            <!-- Rotation Lock (Circle arrow with lock inside) -->
                            <Button styleClass="toolbar-tile-btn, tb-lock-btn" focusTraversable="false">
                                <tooltip>
                                    <Tooltip text="Lock History &amp; Orientation" />
                                </tooltip>
                                <graphic>
                                    <SVGPath content="M 21 12 a 9 9 0 1 1 -9 -9 c 2.52 0 4.93 1 6.74 2.74 L 21 8 M 21 3 v 5 h -5 M 10.2 11.5 V 9.5 a 1.8 1.8 0 0 1 3.6 0 v 2 M 9 11.5 h 6 a 1 1 0 0 1 1 1 v 3.5 a 1 1 0 0 1 -1 1 H 9 a 1 1 0 0 1 -1 -1 v -3.5 a 1 1 0 0 1 1 -1 z M 12 13 v 1.5"
                                             styleClass="svg-icon" scaleX="0.95" scaleY="0.95" />
                                </graphic>
                            </Button>
                        </HBox>
                    </HBox>

                    <!-- Display Area -->
                    <HBox fx:id="displaySplitArea" spacing="10" VBox.vgrow="ALWAYS"
                        styleClass="display-split-area">

                        <!-- Working Area (Left) -->
                        <VBox fx:id="workingArea" HBox.hgrow="ALWAYS" styleClass="working-area">
                            <Label text="Working" styleClass="area-title" />
                            <VBox alignment="TOP_LEFT" VBox.vgrow="ALWAYS">
                                <!-- Complex math rendering WebView -->
                                <WebView fx:id="mathWebView" minHeight="0" maxWidth="Infinity" maxHeight="Infinity"
                                    VBox.vgrow="ALWAYS" style="-fx-page-fill: transparent; -fx-background-color: transparent;" />
                                <!-- Old display mapped here temporarily so controller doesn't break -->
                                <TextField fx:id="display" editable="false" text="0" visible="false"
                                    managed="false" />
                                <Label fx:id="expressionLabel" visible="false" managed="false" />
                            </VBox>
                        </VBox>

                        <!-- Divider -->
                        <Region fx:id="verticalDivider" visible="false" managed="false"
                            styleClass="vertical-divider" />

                        <!-- Solution Area (Right) -->
                        <VBox fx:id="solutionArea" HBox.hgrow="ALWAYS" prefWidth="0" minWidth="0"
                            maxWidth="0" styleClass="solution-area">
                            <Label text="Solution" styleClass="area-title" />
                            <StackPane VBox.vgrow="ALWAYS">
                                <!-- Loading Orb State -->
                                <VBox fx:id="loadingBox" alignment="CENTER" visible="true">
                                    <Region VBox.vgrow="ALWAYS" />
                                    <StackPane fx:id="orbContainer" minWidth="110" minHeight="110" maxWidth="110" maxHeight="110" />
                                    <Label text="Generating a&#10;solution..."
                                        textAlignment="CENTER" styleClass="solution-text" />
                                    <Region VBox.vgrow="ALWAYS" />
                                </VBox>

                                <!-- AI Solution WebView -->
                                <WebView fx:id="solutionWebView" visible="false"
                                    style="-fx-page-fill: transparent;" />
                            </StackPane>
                        </VBox>

                    </HBox>

                    <!-- Input Field -->
                    <HBox fx:id="inputAreaHBox" alignment="CENTER_LEFT" styleClass="input-area" spacing="8">
                        <TextField fx:id="mathInputField" promptText="Ask anything about math..." HBox.hgrow="ALWAYS"
                            styleClass="math-input-field" onAction="#handleMathInputSubmit" />
                        <Button fx:id="micButton" styleClass="input-icon-btn, mic-btn" focusTraversable="false" onAction="#handleMicClick">
                            <tooltip>
                                <Tooltip text="Voice Math Input (Speech to Math)" />
                            </tooltip>
                            <graphic>
                                <SVGPath content="M12 14c1.66 0 3-1.34 3-3V5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3zm5.3-3c0 3-2.54 5.1-5.3 5.1S6.7 14 6.7 11H5c0 3.41 2.72 6.23 6 6.72V21h2v-3.28c3.28-.48 6-3.3 6-6.72h-1.7z"
                                         styleClass="svg-icon" scaleX="0.95" scaleY="0.95" />
                            </graphic>
                        </Button>
                        <Button fx:id="cameraButton" styleClass="input-icon-btn, camera-btn" focusTraversable="false" onAction="#handleCameraClick">
                            <tooltip>
                                <Tooltip text="Scan Math Equation (Image to Math)" />
                            </tooltip>
                            <graphic>
                                <SVGPath content="M9.4 4l-.6 1H5C3.9 5 3 5.9 3 7v10c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2h-3.8l-.6-1h-5.2zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"
                                         styleClass="svg-icon" scaleX="0.95" scaleY="0.95" />
                            </graphic>
                        </Button>
                    </HBox>

                    <!-- Mode Selectors -->
                    <HBox fx:id="modeSelectorsHBox" spacing="10" styleClass="mode-selectors">
                        <ComboBox fx:id="modeComboBox" promptText="Advanced" styleClass="mode-combo"
                            HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                        <ComboBox fx:id="equationLibraryBox" promptText="Equation Library"
                            styleClass="mode-combo" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                        <ComboBox fx:id="calculusLibraryBox" promptText="Differentiation"
                            styleClass="mode-combo" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                    </HBox>

                    <!-- Keypad Container -->
                    <StackPane fx:id="keypadContainer" VBox.vgrow="ALWAYS">
                        <!-- Advanced Keypad (Default) -->
                        <GridPane fx:id="advancedKeypad" hgap="8" vgap="8"
                            styleClass="advanced-keypad" maxHeight="Infinity">
                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS" minWidth="40" percentWidth="9" />
                                <ColumnConstraints hgrow="ALWAYS" minWidth="40" percentWidth="9" />
                                <ColumnConstraints hgrow="ALWAYS" minWidth="40" percentWidth="9" />
                                <ColumnConstraints hgrow="ALWAYS" minWidth="40" percentWidth="9" />
                                <ColumnConstraints hgrow="ALWAYS" minWidth="40" percentWidth="9" />
                                <ColumnConstraints hgrow="ALWAYS" minWidth="40" percentWidth="10" />
                                <ColumnConstraints hgrow="ALWAYS" minWidth="40" percentWidth="9" />
                                <ColumnConstraints hgrow="ALWAYS" minWidth="40" percentWidth="9" />
                                <ColumnConstraints hgrow="ALWAYS" minWidth="40" percentWidth="9" />
                                <ColumnConstraints hgrow="ALWAYS" minWidth="40" percentWidth="9" />
                                <ColumnConstraints hgrow="ALWAYS" minWidth="40" percentWidth="9" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints vgrow="ALWAYS" minHeight="25" percentHeight="20.0" />
                                <RowConstraints vgrow="ALWAYS" minHeight="25" percentHeight="20.0" />
                                <RowConstraints vgrow="ALWAYS" minHeight="25" percentHeight="20.0" />
                                <RowConstraints vgrow="ALWAYS" minHeight="25" percentHeight="20.0" />
                                <RowConstraints vgrow="ALWAYS" minHeight="25" percentHeight="20.0" />
                            </rowConstraints>
                            <!-- Row 0 -->
                            <Button focusTraversable="false"
                                styleClass="key-btn, action-btn" onAction="#backspace"
                                onMousePressed="#handleBackspacePressed" onMouseReleased="#handleBackspaceReleased" onMouseExited="#handleBackspaceExited"
                                GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <graphic>
                                    <SVGPath content="M22 3H7c-.69 0-1.32.35-1.67.94l-5 8.33a1.99 1.99 0 0 0 0 2.06l5 8.33c.35.59.98.94 1.67.94h15a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2zm0 18H7.38l-4.5-7.5 4.5-7.5H22v15zm-13.41-4L12 13.59l3.41 3.41 1.41-1.41L13.41 12l3.41-3.41-1.41-1.41L12 10.59 8.59 7.18 7.18 8.59 10.59 12l-3.41 3.41 1.41 1.41z"
                                             styleClass="svg-icon-white" scaleX="0.85" scaleY="0.85" />
                                </graphic>
                            </Button>
                            <Button focusTraversable="false" text="(" styleClass="key-btn, dark-btn"
                                onAction="#handleAdvancedKey" GridPane.columnIndex="1"
                                GridPane.rowIndex="0" />
                            <Button focusTraversable="false" text=")" styleClass="key-btn, dark-btn"
                                onAction="#handleAdvancedKey" GridPane.columnIndex="2"
                                GridPane.rowIndex="0" />
                            <Button focusTraversable="false" text="mod"
                                styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey"
                                GridPane.columnIndex="3" GridPane.rowIndex="0" />
                            <Button focusTraversable="false" text="π" styleClass="key-btn, dark-btn"
                                onAction="#handleAdvancedKey" GridPane.columnIndex="4"
                                GridPane.rowIndex="0" />
                            <Button focusTraversable="false" text="↑n"
                                styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey"
                                GridPane.columnIndex="5" GridPane.rowIndex="0" />
                            <Button focusTraversable="false" text="n↓"
                                styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey"
                                GridPane.columnIndex="6" GridPane.rowIndex="0" />
                            <Button focusTraversable="false" text="cos"
                                styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey"
                                GridPane.columnIndex="7" GridPane.rowIndex="0" />
                            <Button focusTraversable="false" text="sin"
                                styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey"
                                GridPane.columnIndex="8" GridPane.rowIndex="0" />
                            <Button focusTraversable="false" text="tan"
                                styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey"
                                GridPane.columnIndex="9" GridPane.rowIndex="0" />
                            <Button focusTraversable="false" text="csc"
                                styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey"
                                GridPane.columnIndex="10" GridPane.rowIndex="0" />
                            <!-- Row 1 -->
                            <Button focusTraversable="false" fx:id="btn7" text="7"
                                styleClass="key-btn" onAction="#handleAdvancedKey"
                                GridPane.columnIndex="0" GridPane.rowIndex="1" />
                            <Button focusTraversable="false" fx:id="btn8" text="8"
                                styleClass="key-btn" onAction="#handleAdvancedKey"
                                GridPane.columnIndex="1" GridPane.rowIndex="1" />
                            <Button focusTraversable="false" fx:id="btn9" text="9"
                                styleClass="key-btn" onAction="#handleAdvancedKey"
                                GridPane.columnIndex="2" GridPane.rowIndex="1" />
                            <Button focusTraversable="false" fx:id="btnDivide" text="÷"
                                styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey"
                                GridPane.columnIndex="3" GridPane.rowIndex="1" />
                            <Button focusTraversable="false" text="√" styleClass="key-btn, dark-btn"
                                onAction="#handleAdvancedKey" GridPane.columnIndex="4"
                                GridPane.rowIndex="1" />
                            <Button focusTraversable="false" text="A=B"
                                styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey"
                                GridPane.columnIndex="5" GridPane.rowIndex="1" />
                            <Button focusTraversable="false" text="x10ⁿ"
                                styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey"
                                GridPane.columnIndex="6" GridPane.rowIndex="1" />
                            <Button focusTraversable="false" text="cosh"
                                styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey"
                                GridPane.columnIndex="7" GridPane.rowIndex="1" />
                            <Button focusTraversable="false" text="sinh"
                                styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey"
                                GridPane.columnIndex="8" GridPane.rowIndex="1" />
                            <Button focusTraversable="false" text="tanh"
                                styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey"
                                GridPane.columnIndex="9" GridPane.rowIndex="1" />
                            <Button focusTraversable="false" text="sec"
                                styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey"
                                GridPane.columnIndex="10" GridPane.rowIndex="1" />
                            <!-- Row 2 -->
                            <Button focusTraversable="false" fx:id="btn4" text="4"
                                styleClass="key-btn" onAction="#handleAdvancedKey"
                                GridPane.columnIndex="0" GridPane.rowIndex="2" />
                            <Button focusTraversable="false" fx:id="btn5" text="5"
                                styleClass="key-btn" onAction="#handleAdvancedKey"
                                GridPane.columnIndex="1" GridPane.rowIndex="2" />
                            <Button focusTraversable="false" fx:id="btn6" text="6"
                                styleClass="key-btn" onAction="#handleAdvancedKey"
                                GridPane.columnIndex="2" GridPane.rowIndex="2" />
                            <Button focusTraversable="false" fx:id="btnMultiply" text="×"
                                styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey"
                                GridPane.columnIndex="3" GridPane.rowIndex="2" />
                            <Button focusTraversable="false" text="x²"
                                styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey"
                                GridPane.columnIndex="4" GridPane.rowIndex="2" />
                            <Button focusTraversable="false" text="xʸ"
                                styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey"
                                GridPane.columnIndex="5" GridPane.rowIndex="2" />
                            <Button focusTraversable="false" text="x⁻¹"
                                styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey"
                                GridPane.columnIndex="6" GridPane.rowIndex="2" />
                            <Button focusTraversable="false" text="e" styleClass="key-btn, dark-btn"
                                onAction="#handleAdvancedKey" GridPane.columnIndex="7"
                                GridPane.rowIndex="2" />
                            <Button focusTraversable="false" text="ln"
                                styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey"
                                GridPane.columnIndex="8" GridPane.rowIndex="2" />
                            <Button focusTraversable="false" text="log"
                                styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey"
                                GridPane.columnIndex="9" GridPane.rowIndex="2" />
                            <Button focusTraversable="false" text="cot"
                                styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey"
                                GridPane.columnIndex="10" GridPane.rowIndex="2" />
                            <!-- Row 3 -->
                            <Button focusTraversable="false" fx:id="btn1" text="1"
                                styleClass="key-btn" onAction="#handleAdvancedKey"
                                GridPane.columnIndex="0" GridPane.rowIndex="3" />
                            <Button focusTraversable="false" fx:id="btn2" text="2"
                                styleClass="key-btn" onAction="#handleAdvancedKey"
                                GridPane.columnIndex="1" GridPane.rowIndex="3" />
                            <Button focusTraversable="false" fx:id="btn3" text="3"
                                styleClass="key-btn" onAction="#handleAdvancedKey"
                                GridPane.columnIndex="2" GridPane.rowIndex="3" />
                            <Button focusTraversable="false" fx:id="btnSubtract" text="-"
                                styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey"
                                GridPane.columnIndex="3" GridPane.rowIndex="3" />
                            <Button focusTraversable="false" fx:id="btnEquals" text="="
                                styleClass="key-btn, action-btn" onAction="#handleAdvancedKey"
                                GridPane.columnIndex="4" GridPane.rowIndex="3" GridPane.rowSpan="2" />
                            <Button focusTraversable="false" text="x!"
                                styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey"
                                GridPane.columnIndex="5" GridPane.rowIndex="3" />
                            <Button focusTraversable="false" text="|x|"
                                styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey"
                                GridPane.columnIndex="6" GridPane.rowIndex="3" />
                            <Button focusTraversable="false" text="i" styleClass="key-btn, dark-btn"
