                            <RowConstraints vgrow="ALWAYS" minHeight="40"/>
                        </rowConstraints>
                        <Button text="HEX" styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <Button text="DEC" styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <Button text="OCT" styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                        <Button text="BIN" styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                        <Button text="⌫" styleClass="key-btn, action-btn" onAction="#backspace" GridPane.columnIndex="4" GridPane.rowIndex="0"/>
                        <Button text="C" styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="5" GridPane.rowIndex="0"/>
                        
                        <Button text="A" styleClass="key-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <Button text="B" styleClass="key-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <Button text="7" styleClass="key-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                        <Button text="8" styleClass="key-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                        <Button text="9" styleClass="key-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="4" GridPane.rowIndex="1"/>
                        <Button text="÷" styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="5" GridPane.rowIndex="1"/>
                        
                        <Button text="C" styleClass="key-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                        <Button text="D" styleClass="key-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                        <Button text="4" styleClass="key-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                        <Button text="5" styleClass="key-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="3" GridPane.rowIndex="2"/>
                        <Button text="6" styleClass="key-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="4" GridPane.rowIndex="2"/>
                        <Button text="×" styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="5" GridPane.rowIndex="2"/>
                        
                        <Button text="E" styleClass="key-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                        <Button text="F" styleClass="key-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                        <Button text="1" styleClass="key-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
                        <Button text="2" styleClass="key-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="3" GridPane.rowIndex="3"/>
                        <Button text="3" styleClass="key-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="4" GridPane.rowIndex="3"/>
                        <Button text="-" styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="5" GridPane.rowIndex="3"/>
                        
                        <Button text="AND" styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                        <Button text="OR" styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                        <Button text="0" styleClass="key-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="2" GridPane.rowIndex="4" GridPane.columnSpan="2"/>
                        <Button text="=" styleClass="key-btn, action-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="4" GridPane.rowIndex="4"/>
                        <Button text="+" styleClass="key-btn, dark-btn" onAction="#handleAdvancedKey" GridPane.columnIndex="5" GridPane.rowIndex="4"/>
                    </GridPane>
                </StackPane>
            </VBox>

            <!-- Graphing Layout -->
            <HBox fx:id="graphingLayout" spacing="10" styleClass="calculator-content" visible="false" managed="false">
                <padding>
                    <Insets top="15" right="20" bottom="20" left="20"/>
                </padding>
                
                <!-- Left Side: Graph WebView -->
                <VBox HBox.hgrow="ALWAYS" styleClass="working-area">
                    <WebView fx:id="graphWebView" VBox.vgrow="ALWAYS" style="-fx-page-fill: transparent;" />
                </VBox>
                
                <!-- Right Side: Equations and Keypad -->
                <VBox spacing="10" minWidth="420" maxWidth="450" HBox.hgrow="NEVER">
                    
                    <!-- Mode Selector for Graphing Layout -->
                    <ComboBox fx:id="graphModeComboBox" promptText="Graphing" styleClass="mode-combo" maxWidth="Infinity"/>
                    
                    <!-- Equations List -->
                    <ScrollPane VBox.vgrow="ALWAYS" fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;">
                        <VBox spacing="10">
                            <!-- Equation 1 -->
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="ƒ(x) =" style="-fx-text-fill: white; -fx-font-family: 'Cambria Math'; -fx-font-size: 16px;"/>
                                <TextField fx:id="equation1Field" promptText="Enter an expression" HBox.hgrow="ALWAYS" styleClass="math-input-field"/>
                                <Button text="Plot" onAction="#plotGraph1" styleClass="action-btn"/>
                            </HBox>
                            <!-- Equation 2 -->
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="g(x) =" style="-fx-text-fill: white; -fx-font-family: 'Cambria Math'; -fx-font-size: 16px;"/>
                                <TextField fx:id="equation2Field" promptText="Enter another expression" HBox.hgrow="ALWAYS" styleClass="math-input-field"/>
                                <Button text="Plot" onAction="#plotGraph2" styleClass="action-btn"/>
                            </HBox>
                            
                            <Button text="Clear Graph" onAction="#clearGraph" styleClass="key-btn, dark-btn" maxWidth="Infinity"/>
                        </VBox>
                    </ScrollPane>

                    <!-- Graphing Keypad Wrapper -->
                    <VBox fx:id="graphingKeypad" spacing="0" VBox.vgrow="ALWAYS">
                        <!-- Top Menu Bar -->
                        <HBox spacing="5" alignment="CENTER_LEFT" style="-fx-padding: 10 5;">
                            <ToggleButton fx:id="trigToggle" styleClass="graph-menu-btn" onAction="#toggleTrigPopup" minWidth="-Infinity">
                                <graphic>
                                    <HBox alignment="CENTER" spacing="5">
                                        <SVGPath content="M 2 2 L 2 14 L 14 14 Z M 2 10 L 6 10 L 6 14" stroke="white" strokeWidth="1" fill="transparent"/>
                                        <Label text="Trigonometry" minWidth="-Infinity" style="-fx-text-fill: white; -fx-font-size: 13px; -fx-padding: 0 2 0 0;"/>
                                        <SVGPath content="M 0 0 L 4 4 L 8 0" stroke="white" strokeWidth="1" fill="transparent"/>
                                    </HBox>
                                </graphic>
                            </ToggleButton>
                            <ToggleButton fx:id="ineqToggle" styleClass="graph-menu-btn" onAction="#toggleIneqPopup" minWidth="-Infinity">
                                <graphic>
                                    <HBox alignment="CENTER" spacing="5">
                                        <SVGPath content="M 2 14 L 2 8 L 7 8 L 7 14 Z M 7 14 L 7 4 L 14 4 L 14 14 Z" stroke="white" strokeWidth="1" fill="transparent"/>
                                        <Label text="Inequalities" minWidth="-Infinity" style="-fx-text-fill: white; -fx-font-size: 13px; -fx-padding: 0 2 0 0;"/>
                                        <SVGPath content="M 0 0 L 4 4 L 8 0" stroke="white" strokeWidth="1" fill="transparent"/>
                                    </HBox>
                                </graphic>
                            </ToggleButton>
                            <ToggleButton fx:id="funcToggle" styleClass="graph-menu-btn" onAction="#toggleFuncPopup" minWidth="-Infinity">
                                <graphic>
                                    <HBox alignment="CENTER" spacing="5">
                                        <Label text="ƒ" minWidth="-Infinity" style="-fx-text-fill: white; -fx-font-size: 15px; -fx-font-style: italic; -fx-font-family: 'Georgia', serif;"/>
                                        <Label text="Function" minWidth="-Infinity" style="-fx-text-fill: white; -fx-font-size: 13px; -fx-padding: 0 2 0 0;"/>
                                        <SVGPath content="M 0 0 L 4 4 L 8 0" stroke="white" strokeWidth="1" fill="transparent"/>
                                    </HBox>
                                </graphic>
                            </ToggleButton>
                        </HBox>

                        <StackPane VBox.vgrow="ALWAYS">
                            <!-- Main Graphing Keypad -->
                            <GridPane hgap="8" vgap="8" styleClass="advanced-keypad">
                                <columnConstraints>
                                    <ColumnConstraints hgrow="ALWAYS" minWidth="40" percentWidth="20"/>
                                    <ColumnConstraints hgrow="ALWAYS" minWidth="40" percentWidth="20"/>
                                    <ColumnConstraints hgrow="ALWAYS" minWidth="40" percentWidth="20"/>
                                    <ColumnConstraints hgrow="ALWAYS" minWidth="40" percentWidth="20"/>
                                    <ColumnConstraints hgrow="ALWAYS" minWidth="40" percentWidth="20"/>
                                </columnConstraints>
                                <rowConstraints>
                                    <RowConstraints vgrow="ALWAYS" minHeight="40"/>
                                    <RowConstraints vgrow="ALWAYS" minHeight="40"/>
                                    <RowConstraints vgrow="ALWAYS" minHeight="40"/>
                                    <RowConstraints vgrow="ALWAYS" minHeight="40"/>
                                    <RowConstraints vgrow="ALWAYS" minHeight="40"/>
                                    <RowConstraints vgrow="ALWAYS" minHeight="40"/>
                                </rowConstraints>
                                
                                <!-- Row 0 -->
                                <Button text="x²" styleClass="key-btn, dark-btn" onAction="#handleGraphingKey" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                <Button text="x⁻¹" styleClass="key-btn, dark-btn" onAction="#handleGraphingKey" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                                <Button text="|x|" styleClass="key-btn, dark-btn" onAction="#handleGraphingKey" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                                <Button text="C" styleClass="key-btn, dark-btn" onAction="#handleGraphingKey" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                                <Button text="⌫" styleClass="key-btn, dark-btn" onAction="#handleGraphingKey" GridPane.columnIndex="4" GridPane.rowIndex="0"/>
                                
                                <!-- Row 1 -->
                                <Button text="∛x" styleClass="key-btn, dark-btn" onAction="#handleGraphingKey" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                <Button text="(" styleClass="key-btn, dark-btn" onAction="#handleGraphingKey" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                                <Button text=")" styleClass="key-btn, dark-btn" onAction="#handleGraphingKey" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                                <Button text="x" styleClass="key-btn, dark-btn" onAction="#handleGraphingKey" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                                <Button text="y" styleClass="key-btn, dark-btn" onAction="#handleGraphingKey" GridPane.columnIndex="4" GridPane.rowIndex="1"/>
                                
                                <!-- Row 2 -->
                                <Button text="xʸ" styleClass="key-btn, dark-btn" onAction="#handleGraphingKey" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                                <Button text="7" styleClass="key-btn" onAction="#handleGraphingKey" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                                <Button text="8" styleClass="key-btn" onAction="#handleGraphingKey" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                                <Button text="9" styleClass="key-btn" onAction="#handleGraphingKey" GridPane.columnIndex="3" GridPane.rowIndex="2"/>
                                <Button text="÷" styleClass="key-btn, dark-btn" onAction="#handleGraphingKey" GridPane.columnIndex="4" GridPane.rowIndex="2"/>
                                
                                <!-- Row 3 -->
                                <Button text="10ˣ" styleClass="key-btn, dark-btn" onAction="#handleGraphingKey" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                                <Button text="4" styleClass="key-btn" onAction="#handleGraphingKey" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                                <Button text="5" styleClass="key-btn" onAction="#handleGraphingKey" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
                                <Button text="6" styleClass="key-btn" onAction="#handleGraphingKey" GridPane.columnIndex="3" GridPane.rowIndex="3"/>
                                <Button text="×" styleClass="key-btn, dark-btn" onAction="#handleGraphingKey" GridPane.columnIndex="4" GridPane.rowIndex="3"/>
                                
                                <!-- Row 4 -->
                                <Button text="log" styleClass="key-btn, dark-btn" onAction="#handleGraphingKey" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                                <Button text="1" styleClass="key-btn" onAction="#handleGraphingKey" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                                <Button text="2" styleClass="key-btn" onAction="#handleGraphingKey" GridPane.columnIndex="2" GridPane.rowIndex="4"/>
                                <Button text="3" styleClass="key-btn" onAction="#handleGraphingKey" GridPane.columnIndex="3" GridPane.rowIndex="4"/>
                                <Button text="-" styleClass="key-btn, dark-btn" onAction="#handleGraphingKey" GridPane.columnIndex="4" GridPane.rowIndex="4"/>
                                
                                <!-- Row 5 -->
                                <Button text="ln" styleClass="key-btn, dark-btn" onAction="#handleGraphingKey" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                                <Button text="±" styleClass="key-btn" onAction="#handleGraphingKey" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
                                <Button text="0" styleClass="key-btn" onAction="#handleGraphingKey" GridPane.columnIndex="2" GridPane.rowIndex="5"/>
                                <Button text="." styleClass="key-btn" onAction="#handleGraphingKey" GridPane.columnIndex="3" GridPane.rowIndex="5"/>
                                <Button text="⏎" styleClass="key-btn, action-btn" onAction="#handleGraphingKey" GridPane.columnIndex="4" GridPane.rowIndex="5"/>
                            </GridPane>

                            <!-- Trigonometry Overlay -->
                            <GridPane fx:id="trigPopup" visible="false" managed="false" StackPane.alignment="TOP_LEFT" maxWidth="-Infinity" maxHeight="-Infinity" hgap="4" vgap="4" styleClass="custom-popup" translateX="10" translateY="5">
                                <Button text="2ⁿᵈ" styleClass="key-btn, dark-btn, popup-key-btn" onAction="#handleGraphingKey" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                <Button text="sin" styleClass="key-btn, dark-btn, popup-key-btn" onAction="#handleGraphingKey" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                                <Button text="cos" styleClass="key-btn, dark-btn, popup-key-btn" onAction="#handleGraphingKey" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                                <Button text="tan" styleClass="key-btn, dark-btn, popup-key-btn" onAction="#handleGraphingKey" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                                <Button text="hyp" styleClass="key-btn, dark-btn, popup-key-btn" onAction="#handleGraphingKey" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                <Button text="sec" styleClass="key-btn, dark-btn, popup-key-btn" onAction="#handleGraphingKey" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                                <Button text="csc" styleClass="key-btn, dark-btn, popup-key-btn" onAction="#handleGraphingKey" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                                <Button text="cot" styleClass="key-btn, dark-btn, popup-key-btn" onAction="#handleGraphingKey" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                            </GridPane>

                            <!-- Inequalities Overlay -->
                            <GridPane fx:id="ineqPopup" visible="false" managed="false" StackPane.alignment="TOP_CENTER" maxWidth="-Infinity" maxHeight="-Infinity" hgap="4" vgap="4" styleClass="custom-popup" translateY="5">
                                <Button text="&lt;" styleClass="key-btn, dark-btn, popup-key-btn" onAction="#handleGraphingKey" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                <Button text="≤" styleClass="key-btn, dark-btn, popup-key-btn" onAction="#handleGraphingKey" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                                <Button text="=" styleClass="key-btn, dark-btn, popup-key-btn" onAction="#handleGraphingKey" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                                <Button text="≥" styleClass="key-btn, dark-btn, popup-key-btn" onAction="#handleGraphingKey" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                                <Button text="&gt;" styleClass="key-btn, dark-btn, popup-key-btn" onAction="#handleGraphingKey" GridPane.columnIndex="4" GridPane.rowIndex="0"/>
                            </GridPane>

                            <!-- Function Overlay -->
                            <GridPane fx:id="funcPopup" visible="false" managed="false" StackPane.alignment="TOP_RIGHT" maxWidth="-Infinity" maxHeight="-Infinity" hgap="4" vgap="4" styleClass="custom-popup" translateX="-10" translateY="5">
                                <Button text="|x|" styleClass="key-btn, dark-btn, popup-key-btn" onAction="#handleGraphingKey" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                <Button text="⌊x⌋" styleClass="key-btn, dark-btn, popup-key-btn" onAction="#handleGraphingKey" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                                <Button text="⌈x⌉" styleClass="key-btn, dark-btn, popup-key-btn" onAction="#handleGraphingKey" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                            </GridPane>
                        </StackPane>
                    </VBox>
                </VBox>
            </HBox>
            </StackPane>
        </center>
    </BorderPane>

</StackPane>