                                <Button focusTraversable="false" text="Clear Graph"
                                    onAction="#clearGraph" styleClass="key-btn, dark-btn"
                                    maxWidth="Infinity" />
                            </VBox>
                        </ScrollPane>

                        <!-- Graphing Keypad Wrapper -->
                        <VBox fx:id="graphingKeypad" spacing="0" VBox.vgrow="NEVER" minHeight="360">
                            <!-- Top Menu Bar -->
                            <HBox spacing="5" alignment="CENTER_LEFT" style="-fx-padding: 10 5;">
                                <ToggleButton focusTraversable="false" fx:id="trigToggle"
                                    styleClass="graph-menu-btn" onAction="#toggleTrigPopup"
                                    minWidth="-Infinity">
                                    <graphic>
                                        <HBox alignment="CENTER" spacing="5">
                                            <SVGPath
                                                content="M 2 2 L 2 14 L 14 14 Z M 2 10 L 6 10 L 6 14"
                                                stroke="white" strokeWidth="1" fill="transparent" />
                                            <Label text="Trigonometry" minWidth="-Infinity"
                                                style="-fx-text-fill: white; -fx-font-size: 13px; -fx-padding: 0 2 0 0;" />
                                            <SVGPath content="M 0 0 L 4 4 L 8 0" stroke="white"
                                                strokeWidth="1" fill="transparent" />
                                        </HBox>
                                    </graphic>
                                </ToggleButton>
                                <ToggleButton focusTraversable="false" fx:id="ineqToggle"
                                    styleClass="graph-menu-btn" onAction="#toggleIneqPopup"
                                    minWidth="-Infinity">
                                    <graphic>
                                        <HBox alignment="CENTER" spacing="5">
                                            <SVGPath
                                                content="M 2 14 L 2 8 L 7 8 L 7 14 Z M 7 14 L 7 4 L 14 4 L 14 14 Z"
                                                stroke="white" strokeWidth="1" fill="transparent" />
                                            <Label text="Inequalities" minWidth="-Infinity"
                                                style="-fx-text-fill: white; -fx-font-size: 13px; -fx-padding: 0 2 0 0;" />
                                            <SVGPath content="M 0 0 L 4 4 L 8 0" stroke="white"
                                                strokeWidth="1" fill="transparent" />
                                        </HBox>
                                    </graphic>
                                </ToggleButton>
                                <ToggleButton focusTraversable="false" fx:id="funcToggle"
                                    styleClass="graph-menu-btn" onAction="#toggleFuncPopup"
                                    minWidth="-Infinity">
                                    <graphic>
                                        <HBox alignment="CENTER" spacing="5">
                                            <Label text="ƒ" minWidth="-Infinity"
                                                style="-fx-text-fill: white; -fx-font-size: 15px; -fx-font-style: italic; -fx-font-family: 'Georgia', serif;" />
                                            <Label text="Function" minWidth="-Infinity"
                                                style="-fx-text-fill: white; -fx-font-size: 13px; -fx-padding: 0 2 0 0;" />
                                            <SVGPath content="M 0 0 L 4 4 L 8 0" stroke="white"
                                                strokeWidth="1" fill="transparent" />
                                        </HBox>
                                    </graphic>
                                </ToggleButton>
                            </HBox>

                            <StackPane VBox.vgrow="ALWAYS">
                                <!-- Main Graphing Keypad -->
                                <GridPane hgap="4" vgap="4" styleClass="advanced-keypad">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="ALWAYS" minWidth="40"
                                            percentWidth="20" />
                                        <ColumnConstraints hgrow="ALWAYS" minWidth="40"
                                            percentWidth="20" />
                                        <ColumnConstraints hgrow="ALWAYS" minWidth="40"
                                            percentWidth="20" />
                                        <ColumnConstraints hgrow="ALWAYS" minWidth="40"
                                            percentWidth="20" />
                                        <ColumnConstraints hgrow="ALWAYS" minWidth="40"
                                            percentWidth="20" />
                                    </columnConstraints>
                                    <rowConstraints>
                                        <RowConstraints vgrow="ALWAYS" minHeight="35" />
                                        <RowConstraints vgrow="ALWAYS" minHeight="35" />
                                        <RowConstraints vgrow="ALWAYS" minHeight="35" />
                                        <RowConstraints vgrow="ALWAYS" minHeight="35" />
                                        <RowConstraints vgrow="ALWAYS" minHeight="35" />
                                        <RowConstraints vgrow="ALWAYS" minHeight="35" />
                                        <RowConstraints vgrow="ALWAYS" minHeight="35" />
                                    </rowConstraints>

                                    <!-- Row 0 -->
                                    <Button focusTraversable="false" text="2nd"
                                        styleClass="key-btn, dark-btn" onAction="#handleGraphingKey"
                                        GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                    <Button focusTraversable="false" text="π"
                                        styleClass="key-btn, dark-btn" onAction="#handleGraphingKey"
                                        GridPane.columnIndex="1" GridPane.rowIndex="0" />
                                    <Button focusTraversable="false" text="e"
                                        styleClass="key-btn, dark-btn" onAction="#handleGraphingKey"
                                        GridPane.columnIndex="2" GridPane.rowIndex="0" />
                                    <Button focusTraversable="false" text="C"
                                        styleClass="key-btn, dark-btn" onAction="#handleGraphingKey"
                                        GridPane.columnIndex="3" GridPane.rowIndex="0" />
                                    <Button focusTraversable="false" text="⌫"
                                        styleClass="key-btn, dark-btn" onAction="#handleGraphingKey"
                                        onMousePressed="#handleBackspacePressed" onMouseReleased="#handleBackspaceReleased" onMouseExited="#handleBackspaceExited"
                                        GridPane.columnIndex="4" GridPane.rowIndex="0" />

                                    <!-- Row 1 -->
                                    <Button focusTraversable="false" text="x²"
                                        styleClass="key-btn, dark-btn" onAction="#handleGraphingKey"
                                        GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                    <Button focusTraversable="false" text="1/x"
                                        styleClass="key-btn, dark-btn" onAction="#handleGraphingKey"
                                        GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                    <Button focusTraversable="false" text="|x|"
                                        styleClass="key-btn, dark-btn" onAction="#handleGraphingKey"
                                        GridPane.columnIndex="2" GridPane.rowIndex="1" />
                                    <Button focusTraversable="false" text="x"
                                        styleClass="key-btn, dark-btn" onAction="#handleGraphingKey"
                                        GridPane.columnIndex="3" GridPane.rowIndex="1" />
                                    <Button focusTraversable="false" text="y"
                                        styleClass="key-btn, dark-btn" onAction="#handleGraphingKey"
                                        GridPane.columnIndex="4" GridPane.rowIndex="1" />

                                    <!-- Row 2 -->
                                    <Button focusTraversable="false" text="√"
                                        styleClass="key-btn, dark-btn" onAction="#handleGraphingKey"
                                        GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                    <Button focusTraversable="false" text="("
                                        styleClass="key-btn, dark-btn" onAction="#handleGraphingKey"
                                        GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                    <Button focusTraversable="false" text=")"
                                        styleClass="key-btn, dark-btn" onAction="#handleGraphingKey"
                                        GridPane.columnIndex="2" GridPane.rowIndex="2" />
                                    <Button focusTraversable="false" text="="
                                        styleClass="key-btn, dark-btn" onAction="#handleGraphingKey"
                                        GridPane.columnIndex="3" GridPane.rowIndex="2" />
                                    <Button focusTraversable="false" text="÷"
                                        styleClass="key-btn, dark-btn" onAction="#handleGraphingKey"
                                        GridPane.columnIndex="4" GridPane.rowIndex="2" />

                                    <!-- Row 3 -->
                                    <Button focusTraversable="false" text="xʸ"
                                        styleClass="key-btn, dark-btn" onAction="#handleGraphingKey"
                                        GridPane.columnIndex="0" GridPane.rowIndex="3" />
                                    <Button focusTraversable="false" text="7" styleClass="key-btn"
                                        onAction="#handleGraphingKey" GridPane.columnIndex="1"
                                        GridPane.rowIndex="3" />
                                    <Button focusTraversable="false" text="8" styleClass="key-btn"
                                        onAction="#handleGraphingKey" GridPane.columnIndex="2"
                                        GridPane.rowIndex="3" />
                                    <Button focusTraversable="false" text="9" styleClass="key-btn"
                                        onAction="#handleGraphingKey" GridPane.columnIndex="3"
                                        GridPane.rowIndex="3" />
                                    <Button focusTraversable="false" text="×"
                                        styleClass="key-btn, dark-btn" onAction="#handleGraphingKey"
                                        GridPane.columnIndex="4" GridPane.rowIndex="3" />

                                    <!-- Row 4 -->
                                    <Button focusTraversable="false" text="10ˣ"
                                        styleClass="key-btn, dark-btn" onAction="#handleGraphingKey"
                                        GridPane.columnIndex="0" GridPane.rowIndex="4" />
                                    <Button focusTraversable="false" text="4" styleClass="key-btn"
                                        onAction="#handleGraphingKey" GridPane.columnIndex="1"
                                        GridPane.rowIndex="4" />
                                    <Button focusTraversable="false" text="5" styleClass="key-btn"
                                        onAction="#handleGraphingKey" GridPane.columnIndex="2"
                                        GridPane.rowIndex="4" />
                                    <Button focusTraversable="false" text="6" styleClass="key-btn"
                                        onAction="#handleGraphingKey" GridPane.columnIndex="3"
                                        GridPane.rowIndex="4" />
                                    <Button focusTraversable="false" text="-"
                                        styleClass="key-btn, dark-btn" onAction="#handleGraphingKey"
                                        GridPane.columnIndex="4" GridPane.rowIndex="4" />

                                    <!-- Row 5 -->
                                    <Button focusTraversable="false" text="log"
                                        styleClass="key-btn, dark-btn" onAction="#handleGraphingKey"
                                        GridPane.columnIndex="0" GridPane.rowIndex="5" />
                                    <Button focusTraversable="false" text="1" styleClass="key-btn"
                                        onAction="#handleGraphingKey" GridPane.columnIndex="1"
                                        GridPane.rowIndex="5" />
                                    <Button focusTraversable="false" text="2" styleClass="key-btn"
                                        onAction="#handleGraphingKey" GridPane.columnIndex="2"
                                        GridPane.rowIndex="5" />
                                    <Button focusTraversable="false" text="3" styleClass="key-btn"
                                        onAction="#handleGraphingKey" GridPane.columnIndex="3"
                                        GridPane.rowIndex="5" />
                                    <Button focusTraversable="false" text="+"
                                        styleClass="key-btn, dark-btn" onAction="#handleGraphingKey"
                                        GridPane.columnIndex="4" GridPane.rowIndex="5" />

                                    <!-- Row 6 -->
                                    <Button focusTraversable="false" text="ln"
                                        styleClass="key-btn, dark-btn" onAction="#handleGraphingKey"
                                        GridPane.columnIndex="0" GridPane.rowIndex="6" />
                                    <Button focusTraversable="false" text="(-)" styleClass="key-btn"
                                        onAction="#handleGraphingKey" GridPane.columnIndex="1"
                                        GridPane.rowIndex="6" />
                                    <Button focusTraversable="false" text="0" styleClass="key-btn"
                                        onAction="#handleGraphingKey" GridPane.columnIndex="2"
                                        GridPane.rowIndex="6" />
                                    <Button focusTraversable="false" text="." styleClass="key-btn"
                                        onAction="#handleGraphingKey" GridPane.columnIndex="3"
                                        GridPane.rowIndex="6" />
                                    <Button focusTraversable="false" text="⏎"
                                        styleClass="key-btn, action-btn"
                                        onAction="#handleGraphingKey" GridPane.columnIndex="4"
                                        GridPane.rowIndex="6" />
                                </GridPane>

                                <!-- Trigonometry Overlay -->
                                <GridPane fx:id="trigPopup" visible="false" managed="false"
                                    StackPane.alignment="TOP_LEFT" maxWidth="-Infinity"
                                    maxHeight="-Infinity" hgap="2" vgap="2"
                                    styleClass="custom-popup" translateX="10" translateY="5">
                                    <Button focusTraversable="false" text="2ⁿᵈ"
                                        styleClass="key-btn, dark-btn, popup-key-btn"
                                        onAction="#handleGraphingKey" GridPane.columnIndex="0"
                                        GridPane.rowIndex="0" />
                                    <Button focusTraversable="false" text="sin"
                                        styleClass="key-btn, dark-btn, popup-key-btn"
                                        onAction="#handleGraphingKey" GridPane.columnIndex="1"
                                        GridPane.rowIndex="0" />
                                    <Button focusTraversable="false" text="cos"
                                        styleClass="key-btn, dark-btn, popup-key-btn"
                                        onAction="#handleGraphingKey" GridPane.columnIndex="2"
                                        GridPane.rowIndex="0" />
                                    <Button focusTraversable="false" text="tan"
                                        styleClass="key-btn, dark-btn, popup-key-btn"
                                        onAction="#handleGraphingKey" GridPane.columnIndex="3"
                                        GridPane.rowIndex="0" />
                                    <Button focusTraversable="false" text="hyp"
                                        styleClass="key-btn, dark-btn, popup-key-btn"
                                        onAction="#handleGraphingKey" GridPane.columnIndex="0"
                                        GridPane.rowIndex="1" />
                                    <Button focusTraversable="false" text="sec"
                                        styleClass="key-btn, dark-btn, popup-key-btn"
                                        onAction="#handleGraphingKey" GridPane.columnIndex="1"
                                        GridPane.rowIndex="1" />
                                    <Button focusTraversable="false" text="csc"
                                        styleClass="key-btn, dark-btn, popup-key-btn"
                                        onAction="#handleGraphingKey" GridPane.columnIndex="2"
                                        GridPane.rowIndex="1" />
                                    <Button focusTraversable="false" text="cot"
                                        styleClass="key-btn, dark-btn, popup-key-btn"
                                        onAction="#handleGraphingKey" GridPane.columnIndex="3"
                                        GridPane.rowIndex="1" />
                                </GridPane>

                                <!-- Inequalities Overlay -->
                                <GridPane fx:id="ineqPopup" visible="false" managed="false"
                                    StackPane.alignment="TOP_CENTER" maxWidth="-Infinity"
                                    maxHeight="-Infinity" hgap="2" vgap="2"
                                    styleClass="custom-popup" translateY="5">
                                    <Button focusTraversable="false" text="&lt;"
                                        styleClass="key-btn, dark-btn, popup-key-btn"
                                        onAction="#handleGraphingKey" GridPane.columnIndex="0"
                                        GridPane.rowIndex="0" />
                                    <Button focusTraversable="false" text="≤"
                                        styleClass="key-btn, dark-btn, popup-key-btn"
                                        onAction="#handleGraphingKey" GridPane.columnIndex="1"
                                        GridPane.rowIndex="0" />
                                    <Button focusTraversable="false" text="="
                                        styleClass="key-btn, dark-btn, popup-key-btn"
                                        onAction="#handleGraphingKey" GridPane.columnIndex="2"
                                        GridPane.rowIndex="0" />
                                    <Button focusTraversable="false" text="≥"
                                        styleClass="key-btn, dark-btn, popup-key-btn"
                                        onAction="#handleGraphingKey" GridPane.columnIndex="3"
                                        GridPane.rowIndex="0" />
                                    <Button focusTraversable="false" text="&gt;"
                                        styleClass="key-btn, dark-btn, popup-key-btn"
                                        onAction="#handleGraphingKey" GridPane.columnIndex="4"
                                        GridPane.rowIndex="0" />
                                </GridPane>

                                <!-- Function Overlay -->
                                <GridPane fx:id="funcPopup" visible="false" managed="false"
                                    StackPane.alignment="TOP_RIGHT" maxWidth="-Infinity"
                                    maxHeight="-Infinity" hgap="2" vgap="2"
                                    styleClass="custom-popup" translateX="-10" translateY="5">
                                    <Button focusTraversable="false" text="|x|"
                                        styleClass="key-btn, dark-btn, popup-key-btn"
                                        onAction="#handleGraphingKey" GridPane.columnIndex="0"
                                        GridPane.rowIndex="0" />
                                    <Button focusTraversable="false" text="⌊x⌋"
                                        styleClass="key-btn, dark-btn, popup-key-btn"
                                        onAction="#handleGraphingKey" GridPane.columnIndex="1"
                                        GridPane.rowIndex="0" />
                                    <Button focusTraversable="false" text="⌈x⌉"
                                        styleClass="key-btn, dark-btn, popup-key-btn"
                                        onAction="#handleGraphingKey" GridPane.columnIndex="2"
                                        GridPane.rowIndex="0" />
                                </GridPane>
                            </StackPane>
                        </VBox>
                    </VBox>
                </HBox>
            </StackPane>
        </center>
    </BorderPane>

</StackPane>