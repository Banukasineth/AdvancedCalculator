<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.banukasineth.advancedcalculator.app.controller.UnitConverterController"
    stylesheets="@../css/style.css"
    styleClass="root-pane" prefHeight="750.0" prefWidth="1050.0">

    <BorderPane fx:id="rootPane" focusTraversable="true" styleClass="main-border-pane">
        
        <!-- Custom Top Bar for Undecorated Window -->
        <top>
            <HBox fx:id="titleBar" alignment="CENTER_LEFT" styleClass="custom-title-bar"
                onMousePressed="#handleTitleBarPressed" onMouseDragged="#handleTitleBarDragged">

                <Button text="≡" onAction="#toggleSidebar" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 24px; -fx-cursor: hand; -fx-padding: 0 15 0 10;"/>

                <!-- App Tabs -->
                <HBox alignment="CENTER_LEFT" spacing="5" styleClass="title-tabs">
                    <HBox alignment="CENTER" styleClass="active-tab">
                        <Label text="Unit Converter" styleClass="tab-text" />
                    </HBox>
                </HBox>

                <Region HBox.hgrow="ALWAYS" />

                <!-- Window Controls -->
                <HBox alignment="CENTER_RIGHT" styleClass="window-controls">
                    <Button text="🗕" styleClass="window-btn, minimize-btn"
                        onAction="#minimizeWindow" />
                    <Button text="🗖" styleClass="window-btn, maximize-btn"
                        onAction="#maximizeWindow" />
                    <Button text="🗙" styleClass="window-btn, close-btn" onAction="#closeWindow" />
                </HBox>
            </HBox>
        </top>

        <!-- Main Content (Sidebar + Converter) -->
        <center>
            <BorderPane>
                <left>
                    <VBox fx:id="sidebar" style="-fx-background-color: transparent;" prefWidth="220" spacing="5">
                        <padding>
                            <Insets top="20" right="0" bottom="20" left="0"/>
                        </padding>
                        <Label text="Converter" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold; -fx-padding: 0 0 10 20;"/>
                        
                        <ListView fx:id="menuList" VBox.vgrow="ALWAYS" 
                                  style="-fx-background-color: transparent; -fx-control-inner-background: transparent; -fx-border-color: transparent; -fx-padding: 0;"/>
                    </VBox>
                </left>
                
                <center>
                    <HBox alignment="CENTER" spacing="40" style="-fx-background-color: transparent;">
                        <padding>
                            <Insets top="40" right="40" bottom="40" left="40"/>
                        </padding>

                        <!-- Left Side: Displays -->
                        <VBox alignment="CENTER_LEFT" spacing="40" HBox.hgrow="ALWAYS">
                            <Label fx:id="titleLabel" text="Length" style="-fx-text-fill: white; -fx-font-size: 36px; -fx-font-weight: bold;"/>
                            
                            <VBox spacing="20">
                                <VBox spacing="10">
                                    <Label fx:id="inputValueField" text="0" style="-fx-font-size: 48px; -fx-text-fill: white; -fx-font-weight: bold;"/>
                                    <ComboBox fx:id="fromUnitBox" styleClass="mode-combo" maxWidth="Infinity" style="-fx-font-size: 18px;" />
                                    <Region style="-fx-background-color: #0078D7; -fx-pref-height: 2px;" />
                                </VBox>
                                
                                <Label text="=" style="-fx-text-fill: #0078D7; -fx-font-size: 36px; -fx-font-weight: bold;"/>
                                
                                <VBox spacing="10">
                                    <Label fx:id="outputValueField" text="0" style="-fx-font-size: 48px; -fx-text-fill: #A0A0A0; -fx-font-weight: bold;"/>
                                    <ComboBox fx:id="toUnitBox" styleClass="mode-combo" maxWidth="Infinity" style="-fx-font-size: 18px;" />
                                    <Region style="-fx-background-color: #555555; -fx-pref-height: 2px;" />
                                </VBox>

                                <!-- Responsive Ruler Component (Visible only for Length) -->
                                <Pane fx:id="visualizerPane" prefHeight="80" style="-fx-background-color: transparent;" managed="false" visible="false" />
                            </VBox>
                        </VBox>

                        <!-- Right Side: NumPad -->
                        <GridPane hgap="10" vgap="10" alignment="CENTER">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="33.3" />
                                <ColumnConstraints percentWidth="33.3" />
                                <ColumnConstraints percentWidth="33.3" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints percentHeight="20" />
                                <RowConstraints percentHeight="20" />
                                <RowConstraints percentHeight="20" />
                                <RowConstraints percentHeight="20" />
                                <RowConstraints percentHeight="20" />
                            </rowConstraints>

                            <Button text="CE" onAction="#clearEntry" GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-background-color: #3b3b3b; -fx-text-fill: white; -fx-font-size: 24px; -fx-background-radius: 8; -fx-cursor: hand;" maxWidth="Infinity" maxHeight="Infinity"/>
                            <Button text="⌫" onAction="#backspace" GridPane.columnIndex="2" GridPane.rowIndex="0" style="-fx-background-color: #3b3b3b; -fx-text-fill: white; -fx-font-size: 24px; -fx-background-radius: 8; -fx-cursor: hand;" maxWidth="Infinity" maxHeight="Infinity"/>

                            <Button text="7" onAction="#appendNumber" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-background-color: #2b2b2b; -fx-text-fill: white; -fx-font-size: 28px; -fx-background-radius: 8; -fx-cursor: hand;" maxWidth="Infinity" maxHeight="Infinity"/>
                            <Button text="8" onAction="#appendNumber" GridPane.columnIndex="1" GridPane.rowIndex="1" style="-fx-background-color: #2b2b2b; -fx-text-fill: white; -fx-font-size: 28px; -fx-background-radius: 8; -fx-cursor: hand;" maxWidth="Infinity" maxHeight="Infinity"/>
                            <Button text="9" onAction="#appendNumber" GridPane.columnIndex="2" GridPane.rowIndex="1" style="-fx-background-color: #2b2b2b; -fx-text-fill: white; -fx-font-size: 28px; -fx-background-radius: 8; -fx-cursor: hand;" maxWidth="Infinity" maxHeight="Infinity"/>

                            <Button text="4" onAction="#appendNumber" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-background-color: #2b2b2b; -fx-text-fill: white; -fx-font-size: 28px; -fx-background-radius: 8; -fx-cursor: hand;" maxWidth="Infinity" maxHeight="Infinity"/>
                            <Button text="5" onAction="#appendNumber" GridPane.columnIndex="1" GridPane.rowIndex="2" style="-fx-background-color: #2b2b2b; -fx-text-fill: white; -fx-font-size: 28px; -fx-background-radius: 8; -fx-cursor: hand;" maxWidth="Infinity" maxHeight="Infinity"/>
                            <Button text="6" onAction="#appendNumber" GridPane.columnIndex="2" GridPane.rowIndex="2" style="-fx-background-color: #2b2b2b; -fx-text-fill: white; -fx-font-size: 28px; -fx-background-radius: 8; -fx-cursor: hand;" maxWidth="Infinity" maxHeight="Infinity"/>

                            <Button text="1" onAction="#appendNumber" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-background-color: #2b2b2b; -fx-text-fill: white; -fx-font-size: 28px; -fx-background-radius: 8; -fx-cursor: hand;" maxWidth="Infinity" maxHeight="Infinity"/>
                            <Button text="2" onAction="#appendNumber" GridPane.columnIndex="1" GridPane.rowIndex="3" style="-fx-background-color: #2b2b2b; -fx-text-fill: white; -fx-font-size: 28px; -fx-background-radius: 8; -fx-cursor: hand;" maxWidth="Infinity" maxHeight="Infinity"/>
                            <Button text="3" onAction="#appendNumber" GridPane.columnIndex="2" GridPane.rowIndex="3" style="-fx-background-color: #2b2b2b; -fx-text-fill: white; -fx-font-size: 28px; -fx-background-radius: 8; -fx-cursor: hand;" maxWidth="Infinity" maxHeight="Infinity"/>

                            <Button text="0" onAction="#appendNumber" GridPane.columnIndex="0" GridPane.rowIndex="4" GridPane.columnSpan="2" style="-fx-background-color: #2b2b2b; -fx-text-fill: white; -fx-font-size: 28px; -fx-background-radius: 8; -fx-cursor: hand;" maxWidth="Infinity" maxHeight="Infinity"/>
                            <Button text="." onAction="#appendDecimal" GridPane.columnIndex="2" GridPane.rowIndex="4" style="-fx-background-color: #2b2b2b; -fx-text-fill: white; -fx-font-size: 28px; -fx-background-radius: 8; -fx-cursor: hand;" maxWidth="Infinity" maxHeight="Infinity"/>
                        </GridPane>
                    </HBox>
                </center>
            </BorderPane>
        </center>
        
    </BorderPane>

</StackPane>
