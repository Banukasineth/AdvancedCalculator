<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.text.Font?>

<GridPane xmlns:fx="http://javafx.com/fxml"
          hgap="10"
          vgap="10"
          styleClass="button-grid">

    <columnConstraints>
        <ColumnConstraints percentWidth="20" hgrow="ALWAYS"/>
        <ColumnConstraints percentWidth="20" hgrow="ALWAYS"/>
        <ColumnConstraints percentWidth="20" hgrow="ALWAYS"/>
        <ColumnConstraints percentWidth="20" hgrow="ALWAYS"/>
        <ColumnConstraints percentWidth="20" hgrow="ALWAYS"/>
    </columnConstraints>

    <rowConstraints>
        <RowConstraints percentHeight="16.66" vgrow="ALWAYS"/>
        <RowConstraints percentHeight="16.66" vgrow="ALWAYS"/>
        <RowConstraints percentHeight="16.66" vgrow="ALWAYS"/>
        <RowConstraints percentHeight="16.66" vgrow="ALWAYS"/>
        <RowConstraints percentHeight="16.66" vgrow="ALWAYS"/>
        <RowConstraints percentHeight="16.66" vgrow="ALWAYS"/>
    </rowConstraints>

    <!-- Row 0 -->
    <Button text="sin" onAction="#scientificUnaryClicked" styleClass="scientific-button"
            GridPane.rowIndex="0" GridPane.columnIndex="0" maxWidth="Infinity" maxHeight="Infinity" focusTraversable="false"/>
    <Button text="cos" onAction="#scientificUnaryClicked" styleClass="scientific-button"
            GridPane.rowIndex="0" GridPane.columnIndex="1" maxWidth="Infinity" maxHeight="Infinity" focusTraversable="false"/>
    <Button text="tan" onAction="#scientificUnaryClicked" styleClass="scientific-button"
            GridPane.rowIndex="0" GridPane.columnIndex="2" maxWidth="Infinity" maxHeight="Infinity" focusTraversable="false"/>
    <Button text="AC" onAction="#clearDisplay"
            GridPane.rowIndex="0" GridPane.columnIndex="3" maxWidth="Infinity" maxHeight="Infinity" focusTraversable="false"/>
    <Button onAction="#backspace" onMousePressed="#handleBackspacePressed" onMouseReleased="#handleBackspaceReleased" onMouseExited="#handleBackspaceExited"
            styleClass="scientific-button, action-btn"
            GridPane.rowIndex="0" GridPane.columnIndex="4" maxWidth="Infinity" maxHeight="Infinity" focusTraversable="false">
        <graphic>
            <SVGPath content="M22 3H7c-.69 0-1.32.35-1.67.94l-5 8.33a1.99 1.99 0 0 0 0 2.06l5 8.33c.35.59.98.94 1.67.94h15a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2zm0 18H7.38l-4.5-7.5 4.5-7.5H22v15zm-13.41-4L12 13.59l3.41 3.41 1.41-1.41L13.41 12l3.41-3.41-1.41-1.41L12 10.59 8.59 7.18 7.18 8.59 10.59 12l-3.41 3.41 1.41 1.41z"
                     styleClass="svg-icon-white" scaleX="0.85" scaleY="0.85" />
        </graphic>
    </Button>

    <!-- Row 1 -->
    <Button text="log" onAction="#scientificUnaryClicked" styleClass="scientific-button"
            GridPane.rowIndex="1" GridPane.columnIndex="0" maxWidth="Infinity" maxHeight="Infinity" focusTraversable="false"/>
    <Button text="ln" onAction="#scientificUnaryClicked" styleClass="scientific-button"
            GridPane.rowIndex="1" GridPane.columnIndex="1" maxWidth="Infinity" maxHeight="Infinity" focusTraversable="false"/>
    <Button text="√" onAction="#scientificUnaryClicked" styleClass="scientific-button"
            GridPane.rowIndex="1" GridPane.columnIndex="2" maxWidth="Infinity" maxHeight="Infinity" focusTraversable="false"/>
    <Button text="\%" onAction="#percentClicked"
            GridPane.rowIndex="1" GridPane.columnIndex="3" maxWidth="Infinity" maxHeight="Infinity" focusTraversable="false"/>
    <Button text="÷" onAction="#operatorClicked" styleClass="operator-button"
            GridPane.rowIndex="1" GridPane.columnIndex="4" maxWidth="Infinity" maxHeight="Infinity" focusTraversable="false"/>

    <!-- Row 2 -->
    <Button text="x²" onAction="#scientificUnaryClicked" styleClass="scientific-button"
            GridPane.rowIndex="2" GridPane.columnIndex="0" maxWidth="Infinity" maxHeight="Infinity" focusTraversable="false"/>
    <Button text="7" onAction="#numberClicked"
            GridPane.rowIndex="2" GridPane.columnIndex="1" maxWidth="Infinity" maxHeight="Infinity" focusTraversable="false"/>
    <Button text="8" onAction="#numberClicked"
            GridPane.rowIndex="2" GridPane.columnIndex="2" maxWidth="Infinity" maxHeight="Infinity" focusTraversable="false"/>
    <Button text="9" onAction="#numberClicked"
            GridPane.rowIndex="2" GridPane.columnIndex="3" maxWidth="Infinity" maxHeight="Infinity" focusTraversable="false"/>
    <Button text="×" onAction="#operatorClicked" styleClass="operator-button"
            GridPane.rowIndex="2" GridPane.columnIndex="4" maxWidth="Infinity" maxHeight="Infinity" focusTraversable="false"/>

    <!-- Row 3 -->
    <Button text="x³" onAction="#scientificUnaryClicked" styleClass="scientific-button"
            GridPane.rowIndex="3" GridPane.columnIndex="0" maxWidth="Infinity" maxHeight="Infinity" focusTraversable="false"/>
    <Button text="4" onAction="#numberClicked"
            GridPane.rowIndex="3" GridPane.columnIndex="1" maxWidth="Infinity" maxHeight="Infinity" focusTraversable="false"/>
    <Button text="5" onAction="#numberClicked"
            GridPane.rowIndex="3" GridPane.columnIndex="2" maxWidth="Infinity" maxHeight="Infinity" focusTraversable="false"/>
    <Button text="6" onAction="#numberClicked"
            GridPane.rowIndex="3" GridPane.columnIndex="3" maxWidth="Infinity" maxHeight="Infinity" focusTraversable="false"/>
    <Button text="-" onAction="#operatorClicked" styleClass="operator-button"
            GridPane.rowIndex="3" GridPane.columnIndex="4" maxWidth="Infinity" maxHeight="Infinity" focusTraversable="false"/>

    <!-- Row 4 -->
    <Button text="1/x" onAction="#scientificUnaryClicked" styleClass="scientific-button"
            GridPane.rowIndex="4" GridPane.columnIndex="0" maxWidth="Infinity" maxHeight="Infinity" focusTraversable="false"/>
    <Button text="1" onAction="#numberClicked"
            GridPane.rowIndex="4" GridPane.columnIndex="1" maxWidth="Infinity" maxHeight="Infinity" focusTraversable="false"/>
    <Button text="2" onAction="#numberClicked"
            GridPane.rowIndex="4" GridPane.columnIndex="2" maxWidth="Infinity" maxHeight="Infinity" focusTraversable="false"/>
    <Button text="3" onAction="#numberClicked"
            GridPane.rowIndex="4" GridPane.columnIndex="3" maxWidth="Infinity" maxHeight="Infinity" focusTraversable="false"/>
    <Button text="+" onAction="#operatorClicked" styleClass="operator-button"
            GridPane.rowIndex="4" GridPane.columnIndex="4" maxWidth="Infinity" maxHeight="Infinity" focusTraversable="false"/>

    <!-- Row 5 -->
    <Button text="π" onAction="#constantClicked" styleClass="scientific-button"
            GridPane.rowIndex="5" GridPane.columnIndex="0" maxWidth="Infinity" maxHeight="Infinity" focusTraversable="false"/>
    <Button text="e" onAction="#constantClicked" styleClass="scientific-button"
            GridPane.rowIndex="5" GridPane.columnIndex="1" maxWidth="Infinity" maxHeight="Infinity" focusTraversable="false"/>
    <Button text="0" onAction="#numberClicked"
            GridPane.rowIndex="5" GridPane.columnIndex="2" maxWidth="Infinity" maxHeight="Infinity" focusTraversable="false"/>
    <Button text="." onAction="#decimalClicked"
            GridPane.rowIndex="5" GridPane.columnIndex="3" maxWidth="Infinity" maxHeight="Infinity" focusTraversable="false"/>
    <Button text="=" onAction="#equalsClicked" styleClass="equals-button"
            GridPane.rowIndex="5" GridPane.columnIndex="4" maxWidth="Infinity" maxHeight="Infinity" focusTraversable="false"/>

</GridPane>